# Caddy gets and renews the HTTPS certificate for AASAAN_DOMAIN automatically (ports 80 and 443 must be open).
# With AASAAN_DOMAIN unset (local testing) it serves https://localhost with Caddy's own local certificate.
{$AASAAN_DOMAIN:localhost} {
	# Compress only text-like responses. Server-sent events (text/event-stream) are deliberately not listed, so they are never buffered.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	header -Server

	# The app sets its own security headers. flush_interval -1 sends each SSE event to the browser immediately.
	reverse_proxy app:8000 {
		flush_interval -1
		transport http {
			response_header_timeout 0
			dial_timeout 5s
		}
	}
}

# Aasaan environment configuration template
# Copy to .env and supply actual values. Never commit real keys.

# ==============================================================================
# Model Providers & AI
# ==============================================================================
# Google AI Studio (REQUIRED for live AI): Serves Gemma 4 (26B/31B)
GEMINI_API_KEY=

# OpenRouter: Fallback provider for Gemma 4, Jev, and Mercury Decide
OPENROUTER_API_KEY=

# TypeSafe: Jev typed decision model (Diagnoser & Curator ranking)
TYPESAFE_API_KEY=

# Sarvam AI: Indic languages reasoning, STT, TTS, translation
SARVAM_API_KEY=

# ==============================================================================
# Web Tools & External Services
# ==============================================================================
# YouTube Data API v3: Video search and chapter markers
YOUTUBE_API_KEY=

# Jina Reader API: High-rate web scraping and content extraction
JINA_API_KEY=

# Firecrawl API: Web scraping and discovery fallback
FIRECRAWL_API_KEY=

# Openverse API: Creative Commons image search credentials
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# ==============================================================================
# Application Configuration & Operational Settings
# ==============================================================================
# Content Security Policy mode: 'report-only' (default), 'enforce', or 'off'
AASAAN_CSP_MODE=report-only

# SSE stream max duration in seconds before clean close (keeps connections under typical proxy cutoffs; the browser reconnects and resumes). Default: 200
AASAAN_SSE_MAX_SECONDS=200

# SSE heartbeat comment interval in seconds to keep idle connections alive (default: 15.0)
AASAAN_SSE_HEARTBEAT_SEC=15.0

# SSE ring buffer size of recent events kept per notebook for reconnection replay (default: 100)
AASAAN_SSE_BUFFER_SIZE=100

# SSE poll interval in seconds while awaiting events (default: 1.0)
AASAAN_SSE_POLL_INTERVAL=1.0

# SSE retry field sent to client in milliseconds (default: 2000)
AASAAN_SSE_RETRY_MS=2000

# Trusted reverse proxy hops from the right in X-Forwarded-For (docker-compose.yml sets 1 for Caddy).
# 0 = trust no proxy headers (use socket peer); 1 = single trusted proxy.
AASAAN_TRUSTED_PROXY_HOPS=1

# SQLite database file path (single instance only). Default: data/aasaan.db (docker-compose.yml sets /app/data/aasaan.db)
AASAAN_DB=

# Uploads directory. Default: data/uploads (docker-compose.yml sets /app/data/uploads)
AASAAN_UPLOADS=

# Backups directory. Default: data/backups (docker-compose.yml sets /app/data/backups)
AASAAN_BACKUP_DIR=

# Backup interval in minutes (default: 5; use 1440 for daily on the VM)
AASAAN_BACKUP_EVERY_MIN=1440

# Backup retention in days; newest 3 valid backups are always preserved (default: 14)
AASAAN_BACKUP_KEEP_DAYS=

# Admin token protecting /api/events and /api/admin/* (header X-Admin-Token)
AASAAN_ADMIN_TOKEN=

# Contact URL or email included in crawler User-Agent header
AASAAN_CONTACT=

# Production domain (e.g. aasaan.example.com)
AASAAN_DOMAIN=

# Rate limit: Maximum notebooks created per IP per hour (default: 12)
AASAAN_NB_PER_HOUR=

# Worker concurrency settings (default: 2)
AASAAN_CHAPTER_CONCURRENCY=
AASAAN_NOTEBOOK_CONCURRENCY=

# Global maximum concurrent model calls (default: 4)
AASAAN_MAX_CALLS=

# Timeouts in seconds
AASAAN_GROUNDED_TIMEOUT_S=
AASAAN_ILLUSTRATOR_TIMEOUT_S=

# Resource finding caps per notebook
FIRECRAWL_MAX_CALLS_PER_NOTEBOOK=
COMMONS_MAX_CALLS_PER_NOTEBOOK=
OPENVERSE_MAX_CALLS_PER_NOTEBOOK=

# Orchestrator strangler switch: 'off' (default), 'on', or 'per-notebook'
AASAAN_ORCHESTRATOR=off

# Developer trace endpoint (/api/dev/trace/{nid}): 'off' (default) or 'on'
AASAAN_TRACE=off

# Chaos engineering test spec (e.g. "tool:commons=fail,model:jev=fail")
AASAAN_CHAOS=
